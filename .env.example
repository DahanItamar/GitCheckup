# Fine-grained personal access token.
# Public repository read access only — zero write scopes.
# Raises the GitHub REST ceiling from 60/hr to 5000/hr. Required: the app
# refuses to boot without it (SPEC §8).
GITHUB_TOKEN=

# HMAC key used to hash caller IPs before they touch the rate-limit table.
# At least 16 characters — a guessable key makes the stored hashes reversible.
# Generate one with: node -e "console.log(crypto.randomUUID())"
RATE_LIMIT_SECRET=

# Neon connection string. Required from M2. Create a free project at
# https://neon.tech, then apply the schema with: pnpm db:migrate
DATABASE_URL=

# "rules" is the default and the only accepted value in v1.
TIPS_PROVIDER=

# Absolute base for OG/embed URLs. Falls back to the Vercel production URL,
# then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
