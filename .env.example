# Set to 1 to run the whole interface against bundled fixtures — no GitHub
# token, no database, no outbound call of any kind (SPEC §11 assumption 12).
# Every page says so in a banner. The three variables below are then unused,
# and unvalidated; leave the rest of this file empty. Any other value, or none,
# and the app boots normally and demands them.
DEMO_MODE=

# Fine-grained personal access token.
# Public repository read access only — zero write scopes.
# Raises the GitHub REST ceiling from 60/hr to 5000/hr. Required: the app
# refuses to boot without it (SPEC §8).
GITHUB_TOKEN=

# HMAC key used to hash caller IPs before they touch the rate-limit table.
# At least 16 characters — a guessable key makes the stored hashes reversible.
# Generate one with: node -e "console.log(crypto.randomUUID())"
RATE_LIMIT_SECRET=

# Neon connection string. Required from M2. Create a free project at
# https://neon.tech, then apply the schema with: pnpm db:migrate
DATABASE_URL=

# "rules" is the default and the only accepted value in v1.
TIPS_PROVIDER=

# Absolute base for OG/embed URLs, and the contact address RepoGauge sends to
# GitHub in its User-Agent (GitHub refuses requests without one and uses it to
# reach the operator). Set this to your production domain before anyone copies
# an embed snippet — they are painful to change afterwards.
# Falls back to the Vercel production URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
